kelp_geo = kelpgdf.copy()


def prepare_temp(df):

    temp_cols = [
        "Temp",
        "Ave_Temp_Shore_Edge",
        "Ave_Temp_Water_Edge",
        "Temp1_Shore_Edge",
        "Temp2_Shore_Edge",
        "Temp1_Water_Edge",
        "Temp2_Water_Edge",
    ]

    for c in temp_cols:
        df[c] = pd.to_numeric(df[c], errors="coerce")


    df["Temp_Final"] = np.where(
        ~df["Temp"].isna(),
        df["Temp"],
        np.where(
            (~df["Ave_Temp_Shore_Edge"].isna()) &
            (~df["Ave_Temp_Water_Edge"].isna()),
            (df["Ave_Temp_Shore_Edge"] + df["Ave_Temp_Water_Edge"]) / 2,
            (
                ((df["Temp1_Shore_Edge"] + df["Temp2_Shore_Edge"]) / 2) +
                ((df["Temp1_Water_Edge"] + df["Temp2_Water_Edge"]) / 2)
            ) / 2
        )
    )

    return df.head()

prepare_temp(kelp_geo)


kelp_geo['Location'] = kelp_geo['Location'].replace({
