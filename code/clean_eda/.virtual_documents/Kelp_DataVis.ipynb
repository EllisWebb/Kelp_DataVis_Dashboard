step = 30
overlap = 1

alt.Chart(kelp_clean, height=step).properties(
    width=800
).transform_filter(
        alt.datum.Location == 'Possession Point'
).transform_timeunit(
    Month='month(Survey_Date)', Year='year(Survey_Date)'
).transform_aggregate(
   value='mean(area_acres)', groupby=['Year', 'Month']
).transform_joinaggregate(
    mean_area='mean(value)', groupby=['Year']
).mark_area(
    interpolate='monotone',
    fillOpacity=0.8,
    stroke='lightgray',
    strokeWidth=0.5
).encode(
    alt.X('Month:T', title = None),
    alt.Y(
        'value:Q',
        scale=alt.Scale(range=[step, -step * overlap]),
        axis=None
    ),
    alt.Fill(
        'mean_area:Q',
        legend=None,
        scale=alt.Scale(domain=[30, 5], scheme='redyellowblue')
    )
).facet(
    row=alt.Row(
        'Year:T',
        title=None,
        header=alt.Header(labelAngle=0, labelAlign='right', format='%Y')
    )
).properties(
    title='Acres Over Time',
    bounds='flush',
).configure_facet(
    spacing=0
).configure_view(
    stroke=None
).configure_title(
    anchor='end'
)


